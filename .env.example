# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/nextgen?schema=public"

# ---- Auth (NextAuth) ----
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---- Whish Pay (placeholders — real values come from the Whish Pay merchant dashboard) ----
# NOTE: do not fabricate values for these. The payment adapter (/lib/payments/whish) throws a
# clear "not configured" error until they are filled in, and falls back to the MOCK provider
# in development so the booking → ledger flow can still be built and tested end to end.
PAYMENT_PROVIDER="mock" # "mock" | "whish"
WHISH_API_KEY=
WHISH_API_SECRET=
WHISH_BASE_URL=
WHISH_WEBHOOK_SECRET=

# ---- Video (Daily.co) ----
DAILY_API_KEY=
DAILY_DOMAIN=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="NextGen <hello@nextgen.example>"
